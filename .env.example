# ------------------- 通用 -------------------
# 数据源：qweather（默认，和风天气）或 openweathermap
VITE_WEATHER_PROVIDER=qweather

# true = 使用本地 mock 数据，不发起网络请求（没配 Key 时设成 true 就能跑）
VITE_USE_MOCK=true

# 单次请求超时（毫秒）
VITE_REQUEST_TIMEOUT=8000

# ------------------- 和风天气 -------------------
# devapi 是免费开发版域名，正式环境换成控制台给你的 API Host
VITE_WEATHER_API_BASE_URL=https://devapi.qweather.com
VITE_WEATHER_GEO_BASE_URL=https://geoapi.qweather.com
VITE_WEATHER_API_KEY=

# ------------------- OpenWeatherMap -------------------
# 走 https://api.openweathermap.org/data/4.0/onecall
VITE_OPENWEATHER_API_BASE_URL=https://api.openweathermap.org
VITE_OPENWEATHER_API_KEY=
# 接口模式：auto（默认，先用 One Call，未订阅会自动降级）/ onecall / free
# 普通免费 Key 用不了 One Call，设成 auto 或 free 即可
VITE_OPENWEATHER_API_MODE=auto

# metric = 摄氏度 + 米/秒
VITE_OPENWEATHER_UNITS=metric
# 让接口直接返回中文天气描述
VITE_OPENWEATHER_LANG=zh_cn